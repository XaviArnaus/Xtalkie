# Settings for bin/xtalkie. Copy this file to .env (which git ignores) and fill it in.
# Lines are KEY=VALUE; # starts a comment. Values can be quoted. Everything here can also be given as an argument.

# The serial port of the board you work with most. `bin/xtalkie ports` lists them.
# macOS: /dev/cu.usbmodemXXXX   Linux: /dev/ttyACM0   Windows (Git Bash): COM5
PORT=/dev/cu.usbmodem2101

# The WiFi the two units use. It is case sensitive and MUST be the same on both units.
WIFI_SSID=xtalkie
# At least 8 characters (WPA2). If you leave it out, deploy asks for it.
WIFI_PASSWORD=

# 1 = a deploy is a --night one (the board restarts itself after a crash or hang) unless you say --no-night.
NIGHT=1

# Optional: which Python to use (default: .venv in the project, else python3, else python).
# PYTHON=python3
